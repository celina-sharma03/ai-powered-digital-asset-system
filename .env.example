# Copy this file to `.env` (same folder) and fill in values. Never commit `.env`.

# --- Media -------------------------------------------------------------------
# Folder the indexer scans (recursively). Relative paths are resolved from the repo root.
MEDIA_DIR=./data/media
# Where the app keeps its SQLite DB, Qdrant vectors and thumbnails.
STORAGE_DIR=./storage

# --- Dataset download (only needed for backend/scripts/download_dataset.py) --
# Free key from https://www.pexels.com/api/
PEXELS_API_KEY=

# --- External tools ----------------------------------------------------------
# Leave as-is if ffmpeg/ffprobe are on PATH, otherwise give full paths.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# --- Models (all run locally on CPU) ----------------------------------------
CLIP_MODEL=clip-ViT-B-32
TEXT_MODEL=BAAI/bge-small-en-v1.5
WHISPER_MODEL=base
# Seconds of audio transcribed per video (keeps indexing time bounded)
WHISPER_MAX_SECONDS=180

# --- Video frame sampling ---------------------------------------------------
VIDEO_FRAME_INTERVAL_SEC=5
VIDEO_MIN_FRAMES=4
VIDEO_MAX_FRAMES=12

# --- OCR ---------------------------------------------------------------------
# OCR scanned PDF pages (pages with almost no extractable text)
OCR_PDF_PAGES=true
# OCR every image too (slower on CPU; helps posters/flyers with text)
OCR_IMAGES=false

# --- Optional AI captions (off by default) -----------------------------------
# Set CAPTION_PROVIDER=groq and a key to add natural-language captions for images
# and video keyframes. The system works fully without it.
CAPTION_PROVIDER=none
GROQ_API_KEY=
CAPTION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
CAPTION_MAX_PER_RUN=200

# --- Indexing ----------------------------------------------------------------
# A file that fails is retried on later runs up to this many times
MAX_ATTEMPTS=3
